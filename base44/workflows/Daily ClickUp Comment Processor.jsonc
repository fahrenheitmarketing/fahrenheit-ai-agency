{
  "description": "Checks ClickUp tasks for new comments on pending social media posts. Applies requested changes via AI, and tracks approvals from Steven (Copy + Design) and Nick (Design only). Runs every 30 minutes.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_clickup_comment_processor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_comments": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processClickUpComments"
          },
          "then": "end",
          "x-base44": {
            "title": "Process ClickUp comments",
            "description": "Check for new comments, apply changes, track approvals"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily ClickUp Comment Processor"
}
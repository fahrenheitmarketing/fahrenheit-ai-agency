{
  "name": "CaseStudyRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "case_study_id": {
      "type": "string"
    },
    "case_study_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent"
      ],
      "default": "pending"
    }
  },
  "required": [
    "email",
    "case_study_title"
  ]
}